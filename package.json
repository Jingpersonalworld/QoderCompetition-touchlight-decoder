{
  "name": "touchlight-decoder",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "predev": "node scripts/check-node.mjs",
    "prebuild": "node scripts/check-node.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check:handler": "node dev/check-handler.mjs",
    "check:contract": "node dev/check-contract.mjs",
    "check:analyze": "node dev/check-analyze.mjs",
    "check:pages": "node dev/check-pages.mjs",
    "dev:function:node": "node --env-file-if-exists=.env dev/serve-local.mjs",
    "dev:function": "deno run --allow-net=127.0.0.1:8000 dev/function-local.ts",
    "check:function": "deno check functions/index.ts"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.16"
  },
  "type": "module"
}